      "name": "01_Users_CRUD",
      "item": [
        {
          "name": "GET List Users (Page 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {\n    pm.response.to.have.status(200);\n});\npm.test('Response time is below 3000ms', function () {\n    pm.expect(pm.response.responseTime).to.be.below(3000);\n});\npm.test('Content-Type header is application/json', function () {\n    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');\n});\npm.test('Response body contains paginated users array', function () {\n    const json = pm.response.json();\n    pm.expect(json).to.have.property('page', 2);\n    pm.expect(json.data).to.be.an('array').that.is.not.empty;\n    pm.expect(json.data[0]).to.have.all.keys('id', 'email', 'first_name', 'last_name', 'avatar');\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "type": "any"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users?page=2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET Single User (ID 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response time is below 3000ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  "pm.test('User details match expected fields', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('id', 2);",
                  "    pm.expect(json.data.email).to.be.a('string').and.include('@');",
                  "    pm.expect(json.data.first_name).to.be.a('string');",
                  "});"
                ],
