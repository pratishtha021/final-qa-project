# ==============================================================================
# QA CAPSTONE ENVIRONMENT TEMPLATE
# Copy this file to `.env` (never commit `.env`) and fill in your own values.
# ==============================================================================

# Target Web Application (UI + Automation Exercise API)
AE_BASE_URL=https://automationexercise.com

# ReqRes Public REST API (Get free key at https://app.reqres.in/?next=/api-keys)
REQRES_BASE_URL=https://reqres.in
REQRES_API_KEY=your_reqres_api_key_here

# Optional Pre-existing Test Account for UI Smoke Tests (hybrid tests auto-create/delete)
TEST_USER_NAME=QA Candidate
TEST_USER_EMAIL=qa.candidate@example.com
TEST_USER_PASSWORD=ChangeMe123!

# Execution Controls
HEADLESS=true
